# Copy names only. Set the values in Vercel > Project > Settings > Environment Variables.
# NEXT_PUBLIC_* values are built into the page: redeploy after changing them.

# Tally form IDs (the part after tally.so/r/ in the form's share link)
NEXT_PUBLIC_TALLY_EN=
NEXT_PUBLIC_TALLY_MNE=
# Tally webhook signing secret (Tally > form > Integrations > Webhooks > Signing secret)
TALLY_SIGNING_SECRET=

# Brevo
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_TEMPLATE_EN=
BREVO_TEMPLATE_MNE=

# Shared applicant sheet (Google Apps Script web app /exec URL, and the TOKEN set in the script's properties)
SHEET_WEBHOOK_URL=
SHEET_WEBHOOK_TOKEN=

# Meta
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=
# Optional: only while testing in Events Manager > Test events
META_TEST_EVENT_CODE=
# Optional: Graph API version, default v23.0
META_API_VERSION=

# Google
NEXT_PUBLIC_GA4_ID=
# Google Ads conversion as "AW-XXXXXXXXX/LabelXYZ"
NEXT_PUBLIC_GOOGLE_ADS_SEND_TO=

# Public address of this page, e.g. https://taster.ksi-montenegro.com
SITE_URL=

# Facebook lead form follow-up
FB_PAGE_ID=
# System user or Page token with leads_retrieval (sensitive)
FB_PAGE_TOKEN=
# Optional: which lead forms (regex on the form name, or comma-separated ids) and language overrides
FB_FORM_MATCH=
FB_FORM_IDS=
FB_FORM_LANG=
BREVO_FB_LIST_ID=
# {"1en":27,"2en":28,"3en":29,"1mne":30,"2mne":31,"3mne":32}
BREVO_FB_TEMPLATES=
BREVO_SMS_SENDER=
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
INFOBIP_SENDER=
# WhatsApp via Infobip (approved templates), and the switch for texts
INFOBIP_WHATSAPP_SENDER=
INFOBIP_WA_TEMPLATES=
SMS_ENABLED=
# Vercel Cron sends it; the cron routes refuse calls without it
CRON_SECRET=
